{
    "name": "celios/payment",
    "description": "Pluggable payment engine for Celios CMS supporting Stripe, PayPal, Mollie, and Bank Wire Transfer.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Lazar Celic",
            "email": "celiclazar@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Payment\\": ""
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Payment\\PaymentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
